---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lessons = (await getCollection('lessons')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="Все уроки — 1С для новичков">
  <h1>Все уроки курса</h1>
  <p class="lesson-meta">Проходите уроки по порядку — каждый следующий опирается на предыдущие.</p>

  <div class="lesson-grid">
    {
      lessons.map((lesson) => (
        <a class="lesson-card" href={`/lessons/${lesson.id}/`}>
          <span class="num">Урок {lesson.data.order}</span>
          <h3>{lesson.data.title}</h3>
          <p>{lesson.data.description}</p>
        </a>
      ))
    }
  </div>
</BaseLayout>
