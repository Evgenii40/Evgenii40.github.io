---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const lessons = (await getCollection('lessons')).sort(
    (a, b) => a.data.order - b.data.order
  );
  return lessons.map((lesson, i) => ({
    params: { id: lesson.id },
    props: {
      lesson,
      prev: i > 0 ? lessons[i - 1] : undefined,
      next: i < lessons.length - 1 ? lessons[i + 1] : undefined,
    },
  }));
}

const { lesson, prev, next } = Astro.props;
const { Content } = await render(lesson);
---

<BaseLayout title={`${lesson.data.title} — 1С для новичков`}>
  <article>
    <h1>{lesson.data.title}</h1>
    <p class="lesson-meta">Урок {lesson.data.order} · {lesson.data.description}</p>

    <Content />

    <nav class="lesson-nav">
      {
        prev ? (
          <a href={`/lessons/${prev.id}/`}>← {prev.data.title}</a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`/lessons/${next.id}/`}>{next.data.title} →</a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</BaseLayout>
