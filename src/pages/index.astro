---
import BaseLayout from '../layouts/BaseLayout.astro';
import CheatList from '../components/CheatList.astro';
import { getCollection } from 'astro:content';

const cheats = (await getCollection('cheats')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="Конфиг Хаб — практические инструкции">
  <h1>Конфиг Хаб</h1>
  <p class="cheat-meta">
    Шпаргалки по работе с 1С: интеграции, настройка, администрирование и приёмы
    работы с платформой 1С:Предприятие. Без теории и обучающих курсов —
    только то, что нужно, чтобы быстро сделать задачу.
  </p>

  <CheatList cheats={cheats} />
</BaseLayout>
