---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const cheats = (await getCollection('cheats')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="Шпаргалки по 1С — практические инструкции">
  <h1>Шпаргалки по работе с 1С</h1>
  <p class="cheat-meta">
    Короткие практические инструкции: интеграции, настройка, администрирование
    и приёмы работы с платформой 1С:Предприятие. Без теории и обучающих курсов —
    только то, что нужно, чтобы быстро сделать задачу.
  </p>

  <div class="cheat-grid">
    {
      cheats.map((cheat) => (
        <a class="cheat-card" href={`/cheats/${cheat.id}/`}>
          {cheat.data.tag && <span class="tag">{cheat.data.tag}</span>}
          <h3>{cheat.data.title}</h3>
          <p>{cheat.data.description}</p>
        </a>
      ))
    }
  </div>
</BaseLayout>
