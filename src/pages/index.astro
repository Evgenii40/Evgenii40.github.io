---
import BaseLayout from '../layouts/BaseLayout.astro';
import CheatList from '../components/CheatList.astro';
import { getCollection } from 'astro:content';

const cheats = (await getCollection('cheats')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Конфиг Хаб — практические инструкции по 1С"
  description="Шпаргалки по 1С: интеграции, настройка, администрирование и приёмы работы с платформой 1С:Предприятие. Без теории — только то, что нужно, чтобы быстро сделать задачу."
>
  <h1 class="page-lead">
    Шпаргалки по работе с 1С: интеграции, настройка, администрирование и приёмы
    работы с платформой 1С:Предприятие.
  </h1>

  <section class="start-here">
    <h2>С чего начать</h2>
    <p>
      «Конфиг Хаб» — короткие практические инструкции по 1С: интеграции, настройка,
      администрирование.
    </p>
    <ul>
      <li>
        <strong>Совсем не знакомы с темой?</strong>{' '}
        Загляните в <a href="/glossary/">глоссарий</a>{' '}— там простыми словами
        объяснены термины (API, REST, RLS, регламентное задание и другие).
      </li>
      <li>
        <strong>Ищете конкретную задачу?</strong>{' '}
        Откройте <a href="/cheats/">все шпаргалки</a>{' '}или воспользуйтесь поиском
        в шапке.
      </li>
      <li>
        <strong>Настраиваете систему впервые?</strong>{' '}
        Начните с раздела «Настройка»: почта, права доступа, регламентные задания,
        технологический журнал.
      </li>
    </ul>
    <p class="start-here-more">
      Что это за проект и как им пользоваться — на странице{' '}
      <a href="/about/">«О проекте»</a>.
    </p>
  </section>

  <CheatList cheats={cheats} />
</BaseLayout>
