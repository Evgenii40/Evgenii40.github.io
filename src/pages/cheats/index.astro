---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CheatList from '../../components/CheatList.astro';
import { getCollection } from 'astro:content';

const cheats = (await getCollection('cheats')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="Все шпаргалки — Конфиг Хаб">
  <h1>Все шпаргалки</h1>
  <p class="cheat-meta">Короткие практические инструкции по работе с 1С — без теории, сразу к делу.</p>

  <CheatList cheats={cheats} />
</BaseLayout>
