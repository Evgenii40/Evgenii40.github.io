---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const cheats = (await getCollection('cheats')).sort(
    (a, b) => a.data.order - b.data.order
  );
  return cheats.map((cheat, i) => ({
    params: { id: cheat.id },
    props: {
      cheat,
      prev: i > 0 ? cheats[i - 1] : undefined,
      next: i < cheats.length - 1 ? cheats[i + 1] : undefined,
    },
  }));
}

const { cheat, prev, next } = Astro.props;
const { Content, headings } = await render(cheat);
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={`${cheat.data.title} — Конфиг Хаб`} description={cheat.data.description}>
  <article>
    <h1>{cheat.data.title}</h1>
    <p class="cheat-meta">
      {cheat.data.tag && <span class="tag">{cheat.data.tag}</span>}
      {cheat.data.description}
    </p>

    {
      toc.length >= 4 && (
        <nav class="toc" aria-label="Содержание">
          <div class="toc-title">Содержание</div>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <Content />

    <nav class="cheat-nav">
      {
        prev ? (
          <a href={`/cheats/${prev.id}/`}>← {prev.data.title}</a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`/cheats/${next.id}/`}>{next.data.title} →</a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</BaseLayout>
