---
interface CheatData {
  id: string;
  data: {
    title: string;
    description: string;
    tag?: string;
    group?: string;
  };
}

interface Props {
  cheats: CheatData[];
}

const { cheats } = Astro.props;

// разделы (tag) в порядке появления; внутри — блоки (group)
const tagOrder: string[] = [];
for (const c of cheats) {
  const t = c.data.tag ?? '';
  if (t && !tagOrder.includes(t)) tagOrder.push(t);
}

const sections = tagOrder.map((tag) => {
  const items = cheats.filter((c) => c.data.tag === tag);
  const groupOrder: string[] = [];
  for (const c of items) {
    const g = c.data.group ?? '';
    if (g && !groupOrder.includes(g)) groupOrder.push(g);
  }
  const groups = groupOrder.map((g) => ({
    name: g,
    items: items.filter((c) => c.data.group === g),
  }));
  const ungrouped = items.filter((c) => !c.data.group);
  return { tag, groups, ungrouped };
});
---

<div class="cheat-filter" id="cheat-filter">
  <button data-tag="" class="active">Все</button>
  {tagOrder.map((tag) => <button data-tag={tag}>{tag}</button>)}
</div>

<div id="cheat-grid">
  {
    sections.map((section) => (
      <section class="cheat-section" data-tag={section.tag}>
        <h2 class="cheat-section-title">{section.tag}</h2>
        {section.groups.map((group) => (
          <div class="cheat-block">
            <div class="cheat-block-title">{group.name}</div>
            <div class="cheat-grid">
              {group.items.map((cheat) => (
                <a class="cheat-card" href={`/cheats/${cheat.id}/`}>
                  <h3>{cheat.data.title}</h3>
                  <p>{cheat.data.description}</p>
                </a>
              ))}
            </div>
          </div>
        ))}
        {section.ungrouped.length > 0 && (
          <div class="cheat-block">
            <div class="cheat-grid">
              {section.ungrouped.map((cheat) => (
                <a class="cheat-card" href={`/cheats/${cheat.id}/`}>
                  <h3>{cheat.data.title}</h3>
                  <p>{cheat.data.description}</p>
                </a>
              ))}
            </div>
          </div>
        )}
      </section>
    ))
  }
</div>

<p class="cheat-empty" id="cheat-empty" hidden>В этой категории пока нет шпаргалок.</p>

<script>
  const bar = document.getElementById('cheat-filter')!;
  const empty = document.getElementById('cheat-empty')!;
  const sections = [...document.querySelectorAll<HTMLElement>('.cheat-section')];

  bar.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-tag]');
    if (!btn) return;

    bar.querySelectorAll('button').forEach((b) => b.classList.toggle('active', b === btn));
    const tag = btn.dataset.tag ?? '';
    let visible = 0;
    for (const section of sections) {
      const show = tag === '' || section.dataset.tag === tag;
      section.style.display = show ? '' : 'none';
      if (show) visible++;
    }
    empty.hidden = visible > 0;
  });
</script>
