---
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Конфиг Хаб' } = Astro.props;

const cheats = (await getCollection('cheats')).sort(
  (a, b) => a.data.order - b.data.order
);
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // применяем тему до первой отрисовки, чтобы не мигало
      const saved =
        localStorage.getItem('theme') ||
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = saved;
    </script>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo" title="На главную">
        <svg class="logo-mark" viewBox="0 0 48 48" aria-hidden="true">
          <defs>
            <linearGradient id="logo-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#ff7a54"/>
              <stop offset="1" stop-color="#c2482f"/>
            </linearGradient>
          </defs>
          <!-- корпус клавиши -->
          <rect x="4" y="8" width="40" height="34" rx="7" fill="#7a2413" opacity="0.9"/>
          <!-- верхняя грань клавиши с градиентом и тёмной обводкой -->
          <rect x="4" y="5" width="40" height="32" rx="7" fill="url(#logo-grad)" stroke="#5e1c0e" stroke-width="1.6"/>
          <!-- буква К: белая, с тенью сверху и бликом снизу (эффект утопленности) -->
          <path d="M18.2 11.4v17" fill="none" stroke="#3a0f06" stroke-width="4" stroke-linecap="round"/>
          <path d="M31.8 11.4L21 19.9l10.8 8.5" fill="none" stroke="#3a0f06" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M18.2 13.6v17" fill="none" stroke="#ffc9a8" stroke-width="4" stroke-linecap="round" opacity="0.6"/>
          <path d="M31.8 13.6L21 22.1l10.8 8.5" fill="none" stroke="#ffc9a8" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" opacity="0.6"/>
          <path d="M18.2 12.5v17" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round"/>
          <path d="M31.8 12.5L21 21l10.8 8.5" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="logo-text">Конфиг Хаб</span>
      </a>
      <div class="site-search" id="site-search">
        <input
          type="search"
          id="site-search-input"
          placeholder="Поиск по шпаргалкам…"
          autocomplete="off"
          aria-label="Поиск по шпаргалкам"
        />
        <div class="search-results" id="search-results" hidden></div>
      </div>
      <nav class="top-nav">
        <a href="/" class={currentPath === '' ? 'active' : ''}>Главная</a>
        <a href="/cheats/" class={currentPath === '/cheats' ? 'active' : ''}>Все шпаргалки</a>
        <button
          class="theme-switch"
          id="theme-toggle"
          role="switch"
          aria-label="Тёмная тема"
          title="Переключить тему"
        >
          <span class="track">
            <span class="knob">
              <span class="icon-moon">🌙</span>
              <span class="icon-sun">☀️</span>
            </span>
          </span>
          <span class="switch-label">Тёмная тема</span>
        </button>
      </nav>
    </header>

    <div class="page">
      <aside class="sidebar">
        <ol>
          {
            cheats.map((cheat) => {
              const href = `/cheats/${cheat.id}/`;
              return (
                <li>
                  <a href={href} class={currentPath === href.replace(/\/$/, '') ? 'active' : ''}>
                    {cheat.data.title}
                  </a>
                </li>
              );
            })
          }
        </ol>
      </aside>

      <main class="content">
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <p>Конфиг Хаб · konfig-hab.ru</p>
    </footer>

    <script is:inline>
      // Поиск по шпаргалкам в шапке (индекс подтягивается при первом вводе)
      (function () {
        const input = document.getElementById('site-search-input');
        const box = document.getElementById('search-results');
        if (!input || !box) return;

        let index = null;
        const close = () => {
          box.hidden = true;
        };

        const render = (query) => {
          if (!query) {
            close();
            return;
          }
          const q = query.toLowerCase();
          const hits = index
            .map((item) => ({
              item,
              inTitle: item.title.toLowerCase().includes(q),
              inText: item.text.includes(q) || (item.tag || '').toLowerCase().includes(q),
            }))
            .filter((h) => h.inTitle || h.inText)
            .sort((a, b) => Number(b.inTitle) - Number(a.inTitle))
            .slice(0, 8);

          box.innerHTML = '';
          if (!hits.length) {
            const p = document.createElement('p');
            p.className = 'search-empty';
            p.textContent = 'Ничего не найдено';
            box.appendChild(p);
          } else {
            for (const { item } of hits) {
              const a = document.createElement('a');
              a.href = item.url;
              if (item.tag) {
                const s = document.createElement('span');
                s.className = 'tag';
                s.textContent = item.tag;
                a.appendChild(s);
              }
              a.appendChild(document.createTextNode(item.title));
              box.appendChild(a);
            }
          }
          box.hidden = false;
        };

        input.addEventListener('input', async () => {
          if (!index) {
            try {
              index = await (await fetch('/search.json')).json();
            } catch {
              index = [];
            }
          }
          render(input.value.trim());
        });

        input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            input.value = '';
            close();
            input.blur();
          }
        });

        document.addEventListener('click', (e) => {
          if (!e.target.closest('.site-search')) close();
        });
      })();

      // Кнопка «копировать» на блоках кода
      document.querySelectorAll('.content pre').forEach((pre) => {
        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.type = 'button';
        btn.textContent = 'Копировать';
        btn.addEventListener('click', () => {
          const code = pre.querySelector('code')?.innerText ?? pre.innerText;
          navigator.clipboard.writeText(code).then(() => {
            btn.textContent = 'Скопировано ✓';
            setTimeout(() => (btn.textContent = 'Копировать'), 1500);
          });
        });
        pre.appendChild(btn);
      });

      const toggle = document.getElementById('theme-toggle');
      const syncState = () =>
        toggle?.setAttribute(
          'aria-checked',
          String(document.documentElement.dataset.theme === 'dark')
        );
      syncState();
      toggle?.addEventListener('click', () => {
        const next =
          document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        syncState();
      });
    </script>
  </body>
</html>
