---
import { getCollection } from 'astro:content';
import { Font } from 'astro:assets';
import { STAGE } from '../site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Конфиг Хаб',
  description = 'Практические шпаргалки по 1С: интеграции, администрирование и приёмы работы с платформой 1С:Предприятие.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

const cheats = (await getCollection('cheats')).sort(
  (a, b) => a.data.order - b.data.order
);
// группировка шпаргалок для сайдбара: раздел (tag) -> блок (group) -> шпаргалки
const sections = new Map<string, Map<string, typeof cheats>>();
for (const cheat of cheats) {
  const tag = cheat.data.tag ?? 'Разное';
  const group = cheat.data.group ?? '';
  if (!sections.has(tag)) sections.set(tag, new Map());
  const byGroup = sections.get(tag)!;
  if (!byGroup.has(group)) byGroup.set(group, []);
  byGroup.get(group)!.push(cheat);
}
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" id="theme-color" content="#f7f6f3" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <Font cssVariable="--font-sans" preload={[{ subset: 'cyrillic' }, { subset: 'latin' }]} />
    <Font cssVariable="--font-mono" preload={[{ subset: 'cyrillic' }, { subset: 'latin' }]} />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    {STAGE === 'preview' && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Конфиг Хаб" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Конфиг Хаб — практические шпаргалки по 1С" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <script is:inline>
      // применяем тему до первой отрисовки, чтобы не мигало;
      // читаем из localStorage, затем из cookie (приватность телефонов чистит хранилище),
      // и только потом — системная тема
      const readTheme = () => {
        try {
          const v = localStorage.getItem('theme');
          if (v === 'dark' || v === 'light') return v;
        } catch (e) {}
        const m = document.cookie.match(/(?:^|;\s*)theme=(dark|light)/);
        if (m) return m[1];
        return null;
      };
      const saved =
        readTheme() ||
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = saved;
      const themeColor = document.getElementById('theme-color');
      if (themeColor) themeColor.content = saved === 'dark' ? '#0f0c0a' : '#f7f6f3';
    </script>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo" title="На главную">
        <svg class="logo-mark" viewBox="0 0 64 64" aria-hidden="true" fill="none" stroke="#f6d98a" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round">
          <!-- скруглённый квадрат-фон -->
          <rect x="4" y="4" width="56" height="56" rx="14" fill="currentColor" stroke="#3a3a3a" stroke-width="1"/>
          <!-- буква К — реальный контур глифа Jost 600 (открытый Futura), по центру квадрата -->
          <path transform="translate(16.29 17)" d="M3.26 0L3.26 30L9.56 30L9.56 0Z M20.23 0L7.76 14.23L20.7 30L28.16 30L15.09 14.06L27.51 0Z" fill="#ffffff" stroke="none"/>
        </svg>
        <span class="logo-text">Конфиг Хаб</span>
      </a>
      <div class="site-search" id="site-search">
        <input
          type="search"
          id="site-search-input"
          placeholder="Поиск по шпаргалкам…"
          autocomplete="off"
          aria-label="Поиск по шпаргалкам"
        />
        <button
          class="search-submit"
          id="site-search-submit"
          type="button"
          aria-label="Найти"
          title="Найти"
        >
          Найти
        </button>
        <div class="search-results" id="search-results" hidden></div>
      </div>
      <nav class="top-nav">
        <button
          class="header-collapse"
          id="header-collapse"
          type="button"
          aria-label="Скрыть меню"
          title="Скрыть меню"
        >
          Скрыть меню
        </button>
        <a href="/" class={currentPath === '' ? 'active' : ''}>Главная</a>
        <a href="/cheats/" class={currentPath === '/cheats' ? 'active' : ''}>Все шпаргалки</a>
        <a href="/glossary/" class={currentPath === '/glossary' ? 'active' : ''}>Глоссарий</a>
        <a href="/about/" class={currentPath === '/about' ? 'active' : ''}>О проекте</a>
        <button
          class="theme-switch"
          id="theme-toggle"
          role="switch"
          aria-label="Тёмная тема"
          title="Переключить тему"
        >
          <span class="track">
            <span class="knob">
              <span class="icon-moon">🌙</span>
              <span class="icon-sun">☀️</span>
            </span>
          </span>
          <span class="switch-label">Тёмная тема</span>
        </button>
      </nav>
    </header>

    <div class="page">
      <aside class="sidebar">
        <details class="cheats-nav" open>
          <summary>Шпаргалки</summary>
          {
            [...sections.entries()].map(([tag, byGroup]) => (
              <details class="sidebar-group" open data-group={tag}>
                <summary>{tag}</summary>
                {[...byGroup.entries()].map(([group, groupCheats]) => (
                  <details class="sidebar-block" open data-block={group}>
                    {group && <summary class="sidebar-subgroup">{group}</summary>}
                    <ol>
                      {groupCheats.map((cheat) => {
                        const href = `/cheats/${cheat.id}/`;
                        return (
                          <li>
                            <a href={href} class={currentPath === href.replace(/\/$/, '') ? 'active' : ''}>
                              {cheat.data.title}
                            </a>
                          </li>
                        );
                      })}
                    </ol>
                  </details>
                ))}
              </details>
            ))
          }
        </details>
      </aside>

      <main class="content">
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <p>Конфиг Хаб · konfig-hab.ru</p>
    </footer>

    <script is:inline>
      // запоминаем свёрнутые группы сайдбара
      document.querySelectorAll('details.sidebar-group').forEach((group) => {
        const key = 'sb-group:' + (group.dataset.group ?? '');
        if (localStorage.getItem(key) === 'closed') group.open = false;
        group.addEventListener('toggle', () => {
          localStorage.setItem(key, group.open ? 'open' : 'closed');
        });
      });

      // запоминаем свёрнутые блоки внутри разделов сайдбара
      document.querySelectorAll('details.sidebar-block').forEach((block) => {
        const groupEl = block.closest('details.sidebar-group');
        const tag = groupEl ? (groupEl.dataset.group ?? '') : '';
        const key = 'sb-block:' + tag + '|' + (block.dataset.block ?? '');
        if (localStorage.getItem(key) === 'closed') block.open = false;
        block.addEventListener('toggle', () => {
          localStorage.setItem(key, block.open ? 'open' : 'closed');
        });
      });

      // высота липкой шапки — чтобы сайдбар прилипал ровно на своём месте
      (function () {
        const header = document.querySelector('.site-header');
        if (!header) return;
        const apply = () =>
          document.documentElement.style.setProperty('--header-h', header.offsetHeight + 'px');
        apply();
        addEventListener('resize', apply);
      })();

      // Поиск по шпаргалкам в шапке (индекс подтягивается при первом вводе)
      (function () {
        const input = document.getElementById('site-search-input');
        const box = document.getElementById('search-results');
        if (!input || !box) return;

        let index = null;
        const close = () => {
          box.hidden = true;
        };

        const render = (query) => {
          if (!query) {
            close();
            return;
          }
          const q = query.toLowerCase();
          const hits = index
            .map((item) => ({
              item,
              inTitle: item.title.toLowerCase().includes(q),
              inText: item.text.includes(q) || (item.tag || '').toLowerCase().includes(q),
            }))
            .filter((h) => h.inTitle || h.inText)
            .sort((a, b) => Number(b.inTitle) - Number(a.inTitle))
            .slice(0, 8);

          box.innerHTML = '';
          if (!hits.length) {
            const p = document.createElement('p');
            p.className = 'search-empty';
            p.textContent = 'Ничего не найдено';
            box.appendChild(p);
          } else {
            for (const { item } of hits) {
              const a = document.createElement('a');
              a.href = item.url;
              if (item.tag) {
                const s = document.createElement('span');
                s.className = 'tag';
                s.textContent = item.tag;
                a.appendChild(s);
              }
              a.appendChild(document.createTextNode(item.title));
              box.appendChild(a);
            }
          }
          box.hidden = false;
        };

        const doSearch = async () => {
          if (!index) {
            try {
              index = await (await fetch('/search.json')).json();
            } catch {
              index = [];
            }
          }
          render(input.value.trim());
        };

        input.addEventListener('input', doSearch);

        const submit = document.getElementById('site-search-submit');
        if (submit) submit.addEventListener('click', doSearch);

        input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            input.value = '';
            close();
            input.blur();
          }
        });

        document.addEventListener('click', (e) => {
          if (!e.target.closest('.site-search')) close();
        });
      })();

      // Кнопка «копировать» на блоках кода
      document.querySelectorAll('.content pre').forEach((pre) => {
        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.type = 'button';
        btn.textContent = 'Копировать';
        btn.addEventListener('click', () => {
          const code = pre.querySelector('code')?.innerText ?? pre.innerText;
          navigator.clipboard.writeText(code).then(() => {
            btn.textContent = 'Скопировано ✓';
            setTimeout(() => (btn.textContent = 'Копировать'), 1500);
          });
        });
        pre.appendChild(btn);
      });

      const toggle = document.getElementById('theme-toggle');
      const syncState = () =>
        toggle?.setAttribute(
          'aria-checked',
          String(document.documentElement.dataset.theme === 'dark')
        );
      syncState();
      toggle?.addEventListener('click', () => {
        const next =
          document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        // пишем и в хранилище, и в cookie: на телефонах приватность
        // может чистить localStorage, а cookie первой стороны выживает
        try { localStorage.setItem('theme', next); } catch (e) {}
        document.cookie =
          'theme=' + next + ';path=/;max-age=31536000;samesite=lax';
        const themeColor = document.getElementById('theme-color');
        if (themeColor) themeColor.content = next === 'dark' ? '#0f0c0a' : '#f7f6f3';
        syncState();
      });

      // на телефоне список шпаргалок свёрнут, чтобы не занимать весь экран
      if (matchMedia('(max-width: 800px)').matches) {
        document.querySelector('.cheats-nav')?.removeAttribute('open');
      }
    </script>

    <button
      class="header-show"
      id="header-show"
      type="button"
      aria-label="Показать шапку"
      title="Показать шапку"
    >
      <span aria-hidden="true">▼</span>
    </button>

    <button
      class="scroll-top"
      id="scroll-top"
      type="button"
      aria-label="Вернуться к началу"
      title="Вернуться к началу"
    >
      <svg
        viewBox="0 0 24 24"
        width="26"
        height="26"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M7.5 13.2 L12 8.7 L16.5 13.2"></path>
      </svg>
    </button>

    <script is:inline>
      // свернуть/показать шапку (состояние запоминается) и возврат к началу текста
      (function () {
        const root = document.documentElement;
        const header = document.querySelector('.site-header');
        const collapse = document.getElementById('header-collapse');
        const show = document.getElementById('header-show');
        const toTop = document.getElementById('scroll-top');
        if (!header) return;

        const apply = () => {
          const hidden = root.classList.contains('header-hidden');
          root.style.setProperty('--header-h', hidden ? '0px' : header.offsetHeight + 'px');
        };

        const setHidden = (hidden) => {
          root.classList.toggle('header-hidden', hidden);
          try {
            localStorage.setItem('header-hidden', hidden ? '1' : '0');
          } catch (e) {}
          apply();
        };

        try {
          if (localStorage.getItem('header-hidden') === '1') root.classList.add('header-hidden');
        } catch (e) {}

        apply();
        addEventListener('resize', apply);

        if (collapse) collapse.addEventListener('click', () => setHidden(true));
        if (show) show.addEventListener('click', () => setHidden(false));
        if (toTop)
          toTop.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
      })();
    </script>
  </body>
</html>
