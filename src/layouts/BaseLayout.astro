---
import { getCollection } from 'astro:content';
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Конфиг Хаб',
  description = 'Практические шпаргалки по 1С: интеграции, администрирование и приёмы работы с платформой 1С:Предприятие.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const cheats = (await getCollection('cheats')).sort(
  (a, b) => a.data.order - b.data.order
);
// группировка шпаргалок по категории для сайдбара
const groups = new Map<string, typeof cheats>();
for (const cheat of cheats) {
  const tag = cheat.data.tag ?? 'Разное';
  if (!groups.has(tag)) groups.set(tag, []);
  groups.get(tag)!.push(cheat);
}
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" id="theme-color" content="#f7f6f3" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-sans" preload={[{ subset: 'cyrillic' }]} />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Конфиг Хаб" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script is:inline>
      // применяем тему до первой отрисовки, чтобы не мигало
      const saved =
        localStorage.getItem('theme') ||
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = saved;
      const themeColor = document.getElementById('theme-color');
      if (themeColor) themeColor.content = saved === 'dark' ? '#0d1117' : '#f7f6f3';
    </script>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo" title="На главную">
        <svg class="logo-mark" viewBox="0 0 64 64" aria-hidden="true" fill="none" stroke="#f6d98a" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round">
          <!-- скруглённый квадрат-фон -->
          <rect x="4" y="4" width="56" height="56" rx="14" fill="currentColor" stroke="#3a3a3a" stroke-width="1"/>
          <!-- фигурные скобки { } с тёмно-серой обводкой 0,5 -->
          <g stroke="#3a3a3a" stroke-width="5.5">
            <path d="M16 15C12.5 15 11.5 18 11.5 21.5L11.5 28C11.5 30.5 10 32 7.5 32C10 32 11.5 33.5 11.5 36L11.5 42.5C11.5 46 12.5 49 16 49"/>
            <path d="M48 15C51.5 15 52.5 18 52.5 21.5L52.5 28C52.5 30.5 54 32 56.5 32C54 32 52.5 33.5 52.5 36L52.5 42.5C52.5 46 51.5 49 48 49"/>
          </g>
          <path d="M16 15C12.5 15 11.5 18 11.5 21.5L11.5 28C11.5 30.5 10 32 7.5 32C10 32 11.5 33.5 11.5 36L11.5 42.5C11.5 46 12.5 49 16 49"/>
          <path d="M48 15C51.5 15 52.5 18 52.5 21.5L52.5 28C52.5 30.5 54 32 56.5 32C54 32 52.5 33.5 52.5 36L52.5 42.5C52.5 46 51.5 49 48 49"/>
          <!-- буква К — контур из шрифта Inter Bold (не зависит от загрузки шрифта) -->
          <path d="M18.43 44.55L18.43 15.45L24.39 15.45L24.39 27.27L27.75 27.27L36.01 15.45L43.08 15.45L32.73 29.61L43.57 44.55L36.5 44.55L27.73 32.13L24.39 32.13L24.39 44.55Z" fill="#f6d98a" stroke="#3a3a3a" stroke-width="1"/>
        </svg>
        <span class="logo-text">Конфиг Хаб</span>
      </a>
      <div class="site-search" id="site-search">
        <input
          type="search"
          id="site-search-input"
          placeholder="Поиск по шпаргалкам…"
          autocomplete="off"
          aria-label="Поиск по шпаргалкам"
        />
        <div class="search-results" id="search-results" hidden></div>
      </div>
      <nav class="top-nav">
        <a href="/" class={currentPath === '' ? 'active' : ''}>Главная</a>
        <a href="/cheats/" class={currentPath === '/cheats' ? 'active' : ''}>Все шпаргалки</a>
        <button
          class="theme-switch"
          id="theme-toggle"
          role="switch"
          aria-label="Тёмная тема"
          title="Переключить тему"
        >
          <span class="track">
            <span class="knob">
              <span class="icon-moon">🌙</span>
              <span class="icon-sun">☀️</span>
            </span>
          </span>
          <span class="switch-label">Тёмная тема</span>
        </button>
      </nav>
    </header>

    <div class="page">
      <aside class="sidebar">
        <details class="cheats-nav" open>
          <summary>Шпаргалки</summary>
          {
            [...groups.entries()].map(([tag, groupCheats]) => (
              <details class="sidebar-group" open data-group={tag}>
                <summary>{tag}</summary>
                <ol>
                  {groupCheats.map((cheat) => {
                    const href = `/cheats/${cheat.id}/`;
                    return (
                      <li>
                        <a href={href} class={currentPath === href.replace(/\/$/, '') ? 'active' : ''}>
                          {cheat.data.title}
                        </a>
                      </li>
                    );
                  })}
                </ol>
              </details>
            ))
          }
        </details>
      </aside>

      <main class="content">
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <p>Конфиг Хаб · konfig-hab.ru</p>
    </footer>

    <script is:inline>
      // запоминаем свёрнутые группы сайдбара
      document.querySelectorAll('details.sidebar-group').forEach((group) => {
        const key = 'sb-group:' + (group.dataset.group ?? '');
        if (localStorage.getItem(key) === 'closed') group.open = false;
        group.addEventListener('toggle', () => {
          localStorage.setItem(key, group.open ? 'open' : 'closed');
        });
      });

      // Поиск по шпаргалкам в шапке (индекс подтягивается при первом вводе)
      (function () {
        const input = document.getElementById('site-search-input');
        const box = document.getElementById('search-results');
        if (!input || !box) return;

        let index = null;
        const close = () => {
          box.hidden = true;
        };

        const render = (query) => {
          if (!query) {
            close();
            return;
          }
          const q = query.toLowerCase();
          const hits = index
            .map((item) => ({
              item,
              inTitle: item.title.toLowerCase().includes(q),
              inText: item.text.includes(q) || (item.tag || '').toLowerCase().includes(q),
            }))
            .filter((h) => h.inTitle || h.inText)
            .sort((a, b) => Number(b.inTitle) - Number(a.inTitle))
            .slice(0, 8);

          box.innerHTML = '';
          if (!hits.length) {
            const p = document.createElement('p');
            p.className = 'search-empty';
            p.textContent = 'Ничего не найдено';
            box.appendChild(p);
          } else {
            for (const { item } of hits) {
              const a = document.createElement('a');
              a.href = item.url;
              if (item.tag) {
                const s = document.createElement('span');
                s.className = 'tag';
                s.textContent = item.tag;
                a.appendChild(s);
              }
              a.appendChild(document.createTextNode(item.title));
              box.appendChild(a);
            }
          }
          box.hidden = false;
        };

        input.addEventListener('input', async () => {
          if (!index) {
            try {
              index = await (await fetch('/search.json')).json();
            } catch {
              index = [];
            }
          }
          render(input.value.trim());
        });

        input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            input.value = '';
            close();
            input.blur();
          }
        });

        document.addEventListener('click', (e) => {
          if (!e.target.closest('.site-search')) close();
        });
      })();

      // Кнопка «копировать» на блоках кода
      document.querySelectorAll('.content pre').forEach((pre) => {
        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.type = 'button';
        btn.textContent = 'Копировать';
        btn.addEventListener('click', () => {
          const code = pre.querySelector('code')?.innerText ?? pre.innerText;
          navigator.clipboard.writeText(code).then(() => {
            btn.textContent = 'Скопировано ✓';
            setTimeout(() => (btn.textContent = 'Копировать'), 1500);
          });
        });
        pre.appendChild(btn);
      });

      const toggle = document.getElementById('theme-toggle');
      const syncState = () =>
        toggle?.setAttribute(
          'aria-checked',
          String(document.documentElement.dataset.theme === 'dark')
        );
      syncState();
      toggle?.addEventListener('click', () => {
        const next =
          document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        const themeColor = document.getElementById('theme-color');
        if (themeColor) themeColor.content = next === 'dark' ? '#0d1117' : '#f7f6f3';
        syncState();
      });

      // на телефоне список шпаргалок свёрнут, чтобы не занимать весь экран
      if (matchMedia('(max-width: 800px)').matches) {
        document.querySelector('.cheats-nav')?.removeAttribute('open');
      }
    </script>
  </body>
</html>
